# Пересборка локального снимка мест Москвы. Запускается таймером, не сервером:
# пользовательский запрос никогда не ждёт выгрузку города.
[Unit]
Description=FREE: пересборка снимка мест из OpenStreetMap
After=network-online.target
Wants=network-online.target
# Ключ читается только здесь: в секции [Service] systemd его молча игнорирует
# («Unknown key name»), и весь замысел ограничителя пропадал.
# Шесть заходов в сутки, а не бесконечный цикл: сборка, которая падает всегда,
# при RestartSec=300 долбилась бы в Overpass двести восемьдесят восемь раз за
# сутки. Мы пользуемся им бесплатно, и это не та плата, которую стоит брать с
# чужого сервиса за собственную неисправность. Каждый заход продолжает
# недостроенный снимок, так что шести хватает, а таймер всё равно придёт завтра.
StartLimitIntervalSec=86400
StartLimitBurst=6

[Service]
Type=oneshot
User=free
WorkingDirectory=/opt/afishacity
ExecStart=/usr/bin/node --no-warnings=ExperimentalWarning --max-old-space-size=160 scripts/build_osm_snapshot.mjs
# Фоновая сборка не имеет права мешать живому сервису. Клетки уходят в базу по
# мере готовности и нигде не копятся, поэтому и ста шестидесяти мегабайт кучи
# хватает с запасом. Числа согласованы, а не взяты на глаз: V8 к --max-old-space
# добавляет своё, и 160 превращаются в реальный потолок 208 МБ, — MemoryMax
# оставляет над ним больше сотни мегабайт на буферы ответов и на сам процесс.
# Без флага V8 взял бы под кучу половину всей памяти машины, то есть около
# 470 МБ на каждый процесс: два процесса имели бы право занять её целиком.
MemoryHigh=224M
MemoryMax=320M
# Сборка идёт десятки минут и не должна висеть вечно.
TimeoutStartSec=3600
# Упало (зеркала Overpass легли, сеть моргнула) — повторяем: каждый заход
# теперь продолжает недостроенный снимок, а не начинает заново, поэтому
# работа накапливается. Пять минут паузы — чтобы дать сети отдышаться.
Restart=on-failure
RestartSec=300
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/afishacity/data
