# Порт HTTP-сервера (по умолчанию 3000)
PORT=3000

# Ключ OpenAI. Без него текстовый диалог и голос работают в режиме
# scripted fallback, а /api/recommend работает всегда.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-sol

# Ключ 2GIS Catalog API (необязательно). Без него провайдер 2GIS выключен.
DGIS_API_KEY=
