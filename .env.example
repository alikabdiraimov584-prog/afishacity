# Адрес и порт HTTP-сервера. За nginx оставьте 127.0.0.1, в Docker — 0.0.0.0.
HOST=127.0.0.1
PORT=3000

# Токен бота из @BotFather. Если задан, /api/dialogue и /api/recommend принимают только
# запросы с валидной подписью Telegram Mini App (защита ключа Claude). Пусто — проверка выключена.
TELEGRAM_BOT_TOKEN=
# Лимит сообщений в диалог на пользователя за 10 минут
DIALOGUE_RATE_LIMIT=40

# ---- Движок разговора ----
# Какой движок ведёт диалог: auto | claude | yandex.
# auto — Claude, если задан его ключ, иначе Yandex.
AI_PROVIDER=auto

# Ключ Anthropic. Без него текстовый диалог работает в режиме
# scripted fallback (опросник на встроенных данных), а /api/recommend работает всегда.
ANTHROPIC_API_KEY=

# ---- Yandex Cloud: агент-консьерж и живой голос ----
# Нужны оба значения сразу, иначе движок не включится.
# Ключ: консоль Yandex Cloud -> Сервисные аккаунты -> API-ключ.
# Роли сервисному аккаунту: ai.languageModels.user, ai.speechkit-stt.user, ai.speechkit-tts.user.
# Каталог: идентификатор папки (b1g...) из адресной строки консоли.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модель: yandexgpt/latest (умнее) или yandexgpt-lite/latest (дешевле и быстрее).
YANDEX_MODEL=yandexgpt/latest
# Голос SpeechKit: alena, filipp, ermil, jane, omazh, zahar, dasha, julia, lera, marina.
# Эмоцию поддерживают не все голоса; у неподдерживающих параметр просто игнорируется.
YANDEX_VOICE=alena
YANDEX_EMOTION=good
YANDEX_TEMPERATURE=0.3
YANDEX_MAX_TOKENS=1500
# Лимит обращений к распознаванию и синтезу на пользователя за 10 минут.
VOICE_RATE_LIMIT=120

# Модель и глубина размышления для диалога (по умолчанию claude-opus-5 / medium).
# CLAUDE_EFFORT: low | medium | high | xhigh | max
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium

# Ключ 2GIS Catalog API (необязательно). Без него провайдер 2GIS выключен.
DGIS_API_KEY=
